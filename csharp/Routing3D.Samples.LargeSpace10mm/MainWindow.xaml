<Window x:Class="Routing3D.Samples.LargeSpace10mm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Routing3D 10mm DDW_AI_DB Project Viewer"
        Width="1540"
        Height="940"
        Background="#0F141A"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#D9E4EE"/>
        </Style>
        <Style x:Key="LayerCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D9E4EE"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0F141A"/>
            <Setter Property="Foreground" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="#334355"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151B22" BorderBrush="#283241" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock Text="Routing3D 10mm" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="DDW_AI_DB project viewer / OpenVDB routing" Foreground="#8FA3B5" Margin="0,4,0,14"/>

                    <TextBlock Text="Database" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBlock Text="Host" Foreground="#8FA3B5"/>
                    <TextBox x:Name="HostBox" Text="localhost"/>
                    <TextBlock Text="Port / DB" Foreground="#8FA3B5" Margin="0,6,0,0"/>
                    <DockPanel>
                        <TextBox x:Name="PortBox" Text="5432" Width="70" DockPanel.Dock="Left"/>
                        <TextBox x:Name="DatabaseBox" Text="DDW_AI_DB" Margin="8,2,0,0"/>
                    </DockPanel>
                    <TextBlock Text="User / Password" Foreground="#8FA3B5" Margin="0,6,0,0"/>
                    <DockPanel>
                        <TextBox x:Name="UserBox" Text="postgres" Width="120" DockPanel.Dock="Left"/>
                        <TextBox x:Name="PasswordBox" Text="dinno" Margin="8,2,0,0"/>
                    </DockPanel>

                    <Button x:Name="LoadProjectsButton" Content="Load Projects" Click="LoadProjectsButton_Click"/>
                    <ComboBox x:Name="ProjectCombo" DisplayMemberPath="Display"/>
                    <Button x:Name="LoadProjectButton" Content="Load Selected Project" Click="LoadProjectButton_Click"/>
                    <Button x:Name="RouteButton" Content="Route First Equipment PoC -> Duct PoC" Click="RouteButton_Click"/>
                    <Button x:Name="SampleButton" Content="🔬 8단계 샘플 파이프라인 실행" Click="SampleButton_Click"/>

                    <Separator Margin="0,18,0,12" Background="#283241"/>
                    <TextBlock Text="Layers" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="VoxelCheck" Content="Voxel map / project frame" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="ObstacleCheck" Content="Obstacle data" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="OccupancyCheck" Content="Occupancy map (obstacle/equipment/duct/lateral)" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="EquipmentCheck" Content="Equipment + equipment PoC" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="DuctCheck" Content="Duct/lateral + PoC" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="ExistingCheck" Content="Existing design route" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="VisitedCheck" Content="Visited map" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="False" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="PathCheck" Content="New route path" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>
                    <CheckBox x:Name="CollisionCheck" Content="Collision map" Style="{StaticResource LayerCheckBoxStyle}" IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"/>

                    <Separator Margin="0,18,0,12" Background="#283241"/>
                    <TextBlock Text="Native" Foreground="#8FA3B5"/>
                    <TextBlock x:Name="NativeText" Foreground="#F2F6FA" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="20"/>
                    <TextBlock x:Name="LegendText" Foreground="#8FA3B5" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <h:HelixViewport3D x:Name="View"
                               Background="#0F141A"
                               ShowCoordinateSystem="True"
                               ShowFrameRate="True"
                               ZoomExtentsWhenLoaded="True"
                               ShowViewCube="True"
                               IsHeadLightEnabled="True"
                               ModelUpDirection="0,0,1">
                <h:DefaultLights/>
                <h:GridLinesVisual3D x:Name="GroundGrid"
                                     Width="50000"
                                     Length="50000"
                                     MinorDistance="2500"
                                     MajorDistance="10000"
                                     Thickness="1"
                                     Center="25000,25000,0"/>
                <ModelVisual3D x:Name="SceneVisual"/>
            </h:HelixViewport3D>

            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                    Background="#CC151B22" BorderBrush="#334355" BorderThickness="1" Padding="12">
                <TextBlock x:Name="OverlayText" Foreground="#D9E4EE" TextAlignment="Right"/>
            </Border>
        </Grid>
    </Grid>
</Window>