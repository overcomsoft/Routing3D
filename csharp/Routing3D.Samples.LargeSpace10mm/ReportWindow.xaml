<Window x:Class="Routing3D.Samples.LargeSpace10mm.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="8단계 파이프라인 실행 결과"
        Width="1080" Height="720"
        MinWidth="780" MinHeight="500"
        Background="#0F141A"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#D9E4EE"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1E2A38"/>
            <Setter Property="Foreground" Value="#D9E4EE"/>
            <Setter Property="BorderBrush" Value="#334355"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#10161E"/>
            <Setter Property="Foreground" Value="#D9E4EE"/>
            <Setter Property="BorderBrush" Value="#283241"/>
            <Setter Property="RowBackground" Value="#10161E"/>
            <Setter Property="AlternatingRowBackground" Value="#151B22"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#20283A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#20283A"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#1A2332"/>
                        <Setter Property="Foreground" Value="#8FA3B5"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderBrush" Value="#283241"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#D9E4EE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3050"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2840"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 단계 목록 -->
            <Border Grid.Column="0" Background="#151B22" BorderBrush="#283241" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="실행 단계" FontSize="13" FontWeight="SemiBold"
                               Margin="12,12,12,8" Foreground="#8FA3B5"/>
                    <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="StepList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusIcon}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding StatusColor}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding StepName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding WallTimeStr}" FontSize="10" Foreground="#5A7A9A"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#283241"/>

            <!-- 오른쪽: 단계 상세 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Background="#151B22" BorderBrush="#283241" BorderThickness="0,0,0,1" Padding="16,10">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailDesc"  FontSize="11" Foreground="#6A8EAA" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 메트릭 테이블 -->
                <Border Grid.Row="1" BorderBrush="#283241" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="메트릭" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6A8EAA" Margin="16,8,0,4"/>
                        <DataGrid x:Name="MetricsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  MaxHeight="160"
                                  Margin="12,0,12,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="항목" Binding="{Binding Key}" Width="160" FontSize="11"/>
                                <DataGridTextColumn Header="값"   Binding="{Binding Value}" Width="*"  FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- 작업별 결과 -->
                <Border Grid.Row="2" BorderBrush="#283241" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="작업별 결과" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6A8EAA" Margin="16,8,0,4"/>
                        <DataGrid x:Name="TasksGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" IsReadOnly="True"
                                  SelectionMode="Single"
                                  Margin="12,0,12,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"      Binding="{Binding TaskIndex}" Width="32"  FontSize="11"/>
                                <DataGridTextColumn Header="라벨"   Binding="{Binding Label}"     Width="*"   FontSize="11"/>
                                <DataGridTextColumn Header="유틸"   Binding="{Binding Utility}"   Width="80"  FontSize="11"/>
                                <DataGridTextColumn Header="φmm"    Binding="{Binding DiameterMm, StringFormat=F0}" Width="48" FontSize="11"/>
                                <DataGridTextColumn Header="상태"   Binding="{Binding StatusIcon}" Width="40" FontSize="12"/>
                                <DataGridTextColumn Header="길이"   Binding="{Binding LengthStr}"  Width="110" FontSize="11"/>
                                <DataGridTextColumn Header="꺾임"   Binding="{Binding TurnsStr}"   Width="50"  FontSize="11"/>
                                <DataGridTextColumn Header="확장"   Binding="{Binding ExpStr}"     Width="90"  FontSize="11"/>
                                <DataGridTextColumn Header="ms"     Binding="{Binding ElapsedStr}" Width="80"  FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- 로그 레이블 -->
                <TextBlock Grid.Row="3" Text="실행 로그" FontSize="11" FontWeight="SemiBold"
                           Foreground="#6A8EAA" Margin="16,8,0,4"/>

                <!-- 로그 텍스트 -->
                <TextBox Grid.Row="4"
                         x:Name="LogBox"
                         Background="#0C1119"
                         Foreground="#A8C4D8"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Courier New"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Margin="12,0,12,8"
                         Padding="8"/>
            </Grid>
        </Grid>

        <!-- 하단 버튼 바 -->
        <Border Grid.Row="1" Background="#151B22" BorderBrush="#283241" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="FooterText" Foreground="#5A7A9A" FontSize="11"
                           VerticalAlignment="Center" DockPanel.Dock="Left" Margin="4,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenFileButton"  Content="📂 파일 열기"  Click="OpenFileButton_Click"  Margin="0,0,8,0"/>
                    <Button x:Name="CopyButton"      Content="📋 복사"       Click="CopyButton_Click"      Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton"     Content="닫기"           Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
