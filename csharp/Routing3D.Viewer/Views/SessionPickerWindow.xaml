<Window x:Class="Routing3D.Viewer.Views.SessionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="저장된 자동설계 결과 불러오기"
        Width="780" Height="420" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#1e2230" Foreground="#c8d0e0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background"          Value="#252b3d"/>
            <Setter Property="Foreground"          Value="#c8d0e0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333c55"/>
            <Setter Property="BorderBrush"         Value="#333c55"/>
            <Setter Property="RowBackground"       Value="#252b3d"/>
            <Setter Property="AlternatingRowBackground" Value="#2b3245"/>
            <Setter Property="SelectionMode"       Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows"      Value="False"/>
            <Setter Property="CanUserDeleteRows"   Value="False"/>
            <Setter Property="IsReadOnly"          Value="True"/>
            <Setter Property="HeadersVisibility"   Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="#2b3548"/>
            <Setter Property="Foreground"  Value="#8aa3c8"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#404a64"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"     Value="6,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#385b85"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"  Value="#2b3548"/>
            <Setter Property="Foreground"  Value="#c8d0e0"/>
            <Setter Property="BorderBrush" Value="#404a64"/>
            <Setter Property="Padding"     Value="14,5"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <TextBlock Grid.Row="0" Text="불러올 세션을 선택하세요 (최근 50건)"
                   Foreground="#8aa3c8" FontSize="12" Margin="0,0,0,8"/>

        <!-- 세션 목록 -->
        <DataGrid Grid.Row="1" x:Name="SessionGrid"
                  MouseDoubleClick="OnSessionDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="저장시간"        Binding="{Binding LastModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="장비호기명"      Binding="{Binding EquipmentName}"   Width="100"/>
                <DataGridTextColumn Header="셀(mm)"         Binding="{Binding CellMm}"           Width="60"/>
                <DataGridTextColumn Header="성공/전체"       Binding="{Binding SuccessDisplay}"   Width="80"/>
                <DataGridTextColumn Header="총길이(m)"       Binding="{Binding LengthDisplay}"    Width="85"/>
                <DataGridTextColumn Header="라우팅모드"      Binding="{Binding RouteMode}"        Width="110"/>
                <DataGridTextColumn Header="프로젝트"        Binding="{Binding ProjectName}"      Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="불러오기" Click="OnLoad"   MinWidth="90" Background="#385b85" Foreground="White"/>
            <Button Content="취소"     Click="OnCancel" MinWidth="70" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
