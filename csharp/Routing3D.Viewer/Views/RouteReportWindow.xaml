<Window x:Class="Routing3D.Viewer.Views.RouteReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동설계 결과 리포트" Width="720" Height="760"
        Background="#1e2230" WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="False">
    <!-- 직전 자동설계 배치의 결과(설계 순서·꺾임 선정·연결 성공) Markdown 리포트를 보여주는 모드리스 창.
         DataContext = SceneViewModel. RouteResultReport 바인딩으로 내용이 갱신된다. -->
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#e8eaf0"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2b3548"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
            <Setter Property="BorderBrush" Value="#404a64"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- 상단 도구줄 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="자동설계 결과 리포트" FontWeight="Bold" FontSize="14"
                       Foreground="#bfc6d6" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 다른 이름으로 저장…" Click="OnSaveAs"/>
                <Button Content="📋 복사" Click="OnCopy"/>
                <Button Content="📂 폴더 열기" Click="OnOpenFolder"/>
            </StackPanel>
        </DockPanel>
        <!-- 하단 저장 경로 안내 -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="#8a93a8" FontSize="11"
                   Text="{Binding RouteResultReportPath, StringFormat='저장됨: {0}', TargetNullValue='아직 저장되지 않음'}"/>
        <!-- 본문(Markdown 원문, 고정폭) -->
        <Border Background="#252b3d" BorderBrush="#404a64" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding RouteResultReport, Mode=OneWay, TargetNullValue='리포트가 없습니다. 자동설계를 실행한 뒤 다시 시도하세요.'}"
                         IsReadOnly="True" Background="Transparent" Foreground="#cdd6f4"
                         BorderThickness="0" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
