<Window x:Class="Routing3D.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Routing3D Viewer — C++ engine · C# HelixToolkit"
        Width="1520" Height="900"
        Background="#1e2230"
        WindowStartupLocation="CenterScreen">

    <!-- ===== 다크 테마 (SpaceAI 팔레트 호환) ===== -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="MinWidth"        Value="90"/>
            <Setter Property="Background"      Value="#3a4862"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#5a6a8a"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin"     Value="3,2"/>
            <Setter Property="Foreground" Value="#e8eaf0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#bfc6d6"/>
            <Setter Property="Padding"    Value="3,1"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e8eaf0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin"      Value="2"/>
            <Setter Property="Padding"     Value="3,2"/>
            <Setter Property="Background"  Value="#2b3548"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#5a6a8a"/>
        </Style>
        <!-- 다크 ListBox + 항목 호버/선택색 -->
        <Style TargetType="ListBox">
            <Setter Property="Background"      Value="#2b3548"/>
            <Setter Property="Foreground"      Value="#e8eaf0"/>
            <Setter Property="BorderBrush"     Value="#404a64"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top toolbar -->
            <RowDefinition Height="*"/>      <!-- main content -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- =========== Top toolbar (SpaceAI 스타일 DB 접속 + 프로젝트) =========== -->
        <Border Grid.Row="0" Background="#252b3d" BorderBrush="#404a64" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Label   Content="DB:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding DbHost,     Mode=TwoWay}" Width="100" Height="26" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding DbPort,     Mode=TwoWay}" Width="55"  Height="26" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding DbUser,     Mode=TwoWay}" Width="80"  Height="26" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding DbPassword, Mode=TwoWay}" Width="80"  Height="26" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding DbDatabase, Mode=TwoWay}" Width="130" Height="26" VerticalContentAlignment="Center"/>
                <Label   Content="프로젝트:" VerticalAlignment="Center"/>
                <ComboBox Width="300" Height="26" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          ToolTip="space_project_map 의 프로젝트.&#x0a;선택 시 장애물만 로드해 전체화면 표시(라우팅은 '🌐 corridor (대형)' 또는 우측 '선택 배관 재라우팅'으로)."/>
                <Button  Content="↻ 다시 로드" Command="{Binding LoadProjectsCommand}"
                         ToolTip="DB 접속 정보 변경 후 프로젝트 목록을 다시 가져온다"/>
                <Separator Width="1" Background="#404a64" Margin="6,2"/>
                <Button Content="🌐 기존설계 유사 (그룹배관)"  Command="{Binding RerouteCorridorCommand}"
                        ToolTip="전체 배관을 기존설계처럼 '그룹'으로 라우팅: 끝단=기존 스텁(수직+엘보) · 자유공간=그룹배관 패턴(공용 트렁크 회랑)+매칭 기존배관 추종 · 유틸리티 순서로 self-bundling → 같은 유틸 배관이 공용 랙에 평행 다발. 셀이 50mm 보다 크면 자동으로 50mm 재적재(레인 분리 필요)."
                        Background="#3a4e7a" MinWidth="110"/>
                <Button Content="↺ 전체보기"          Command="{Binding FitViewCommand}"
                        ToolTip="3D 뷰를 모든 객체가 들어오도록 자동 줌(ZoomExtents)"/>
                <Button Content="🖼 이미지 저장" Click="OnSaveMainImage" Margin="4,0,0,0"
                        ToolTip="현재 메인 3D 뷰를 PNG/JPG 이미지 파일로 저장(2배 해상도)"/>
                <Button Content="📊 자동설계 리포트" Command="{Binding AutoDesignReportCommand}" Margin="4,0,0,0"
                        Background="#3a4e7a" MinWidth="110"
                        ToolTip="선택 프로젝트/셀로 (장비,유틸그룹) 케이스별 기존/최단/Stub+그룹 자동설계를 수행하고 길이·꺾임·그룹핑 Factor + 3D 스냅샷을 CSV/TXT/HTML 로 출력(출력 폴더 선택). 케이스가 많으면 수 분 소요·생성 중 화면이 잠깐 멈출 수 있음."/>

                <!-- 진단 레이어(디버그용 복셀) — 하단 바에서 상단으로 이동 -->
                <Separator Width="1" Background="#404a64" Margin="6,2"/>
                <TextBlock Text="진단:" FontWeight="Bold" Foreground="#bfc6d6"
                           VerticalAlignment="Center" Margin="2,0,6,0"/>
                <CheckBox Content="격자맵" IsChecked="{Binding ShowGridFrame}" Foreground="#7ADFB0"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="복셀 전체맵 — 작업 공간의 격자 BBOX 12변을 가는 실린더로 표시"/>
                <CheckBox Content="점유맵" IsChecked="{Binding ShowOccupancyVoxels}" Foreground="#82AAC8"
                          VerticalAlignment="Center" Margin="0,0,4,0"
                          ToolTip="엔진이 voxelize 한 블록 셀을 옅은 청회색 큐브로 표시"/>
                <Button Content="{Binding OccupancyResolutionLabel}"
                        Command="{Binding ToggleOccupancyResCommand}"
                        Margin="0,0,10,0" Padding="8,1" MinWidth="0" VerticalAlignment="Center"
                        ToolTip="점유맵 해상도 전환: 원본(전체 셀, 정확하지만 느릴 수 있음) ↔ 다운샘플(상한 15만, 빠름)"/>
                <CheckBox Content="통과맵" IsChecked="{Binding ShowPassthroughVoxels}" Foreground="#5AC8A0"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="통과 객체(바닥/천장/격자보)가 점유는 하되 경로탐색은 통과하는 셀을 청록 큐브로 표시"/>
                <CheckBox Content="방문맵" IsChecked="{Binding ShowVisitedMap}" Foreground="#EBCD3C"
                          VerticalAlignment="Center" Margin="0,0,4,0"
                          ToolTip="각 배관 라우팅 중 A* 가 확장한 셀을 유틸리티 색의 반투명 큐브로. 유틸당 12k 셀 다운샘플"/>
            </StackPanel>
        </Border>

        <!-- =========== Main content =========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>   <!-- Left: 검색·필터·작업목록 -->
                <ColumnDefinition Width="*"/>     <!-- Center: 3D + 레이어 -->
                <ColumnDefinition Width="320"/>   <!-- Right: 범례·선택 작업·편집 -->
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: 드릴다운 (유틸리티 그룹 → 유틸리티 → 개별 PoC) ===== -->
            <Border Grid.Column="0" Background="#252b3d" BorderBrush="#404a64"
                    BorderThickness="0,0,1,0">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 1단계: 그룹 -->
                        <RowDefinition Height="Auto"/>   <!-- 2단계: 유틸리티 -->
                        <RowDefinition Height="*"/>      <!-- 3단계: 개별 PoC -->
                    </Grid.RowDefinitions>

                    <!-- 1단계: 유틸리티 그룹 -->
                    <Border Grid.Row="0" Background="#2b3548" Padding="6"
                            BorderBrush="#404a64" BorderThickness="1" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="① 유틸리티 그룹" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ComboBox Height="26" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding GroupList}"
                                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                      ToolTip="유틸리티 그룹 선택 → 아래 유틸리티 목록이 나오고, 상단 '탐색 범위'가 이 그룹으로 설정됩니다."/>
                            <Button Content="▶ 이 그룹 전체 라우팅"
                                    Command="{Binding RouteGroupCommand}"
                                    Margin="0,6,0,0" Background="#385b85" FontWeight="SemiBold"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="선택한 유틸리티 그룹의 모든 PoC를 한꺼번에 충돌회피 라우팅합니다(충돌확장 ON이면 설비·덕트·기설계 배관도 회피)."/>
                        </StackPanel>
                    </Border>

                    <!-- 2단계: 유틸리티 -->
                    <Border Grid.Row="1" Background="#2b3548" Padding="6"
                            BorderBrush="#404a64" BorderThickness="1" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="② 유틸리티" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Background="#252b3d" BorderBrush="#404a64"
                                    BorderThickness="1" MaxHeight="160">
                                <ListBox ItemsSource="{Binding UtilityList}"
                                         SelectedItem="{Binding SelectedUtility, Mode=TwoWay}"
                                         ToolTip="유틸리티 선택 → 아래 개별 PoC 목록이 나오고, 상단 '탐색 범위'가 이 유틸리티로 설정됩니다."/>
                            </Border>
                            <Button Content="▶ 이 유틸리티 전체 라우팅"
                                    Command="{Binding RouteUtilityCommand}"
                                    Margin="0,6,0,0" Background="#385b85" FontWeight="SemiBold"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="선택한 유틸리티의 모든 PoC를 한꺼번에 충돌회피 라우팅합니다."/>
                            <Button Content="🗑 자동설계 경로 삭제"
                                    Command="{Binding ClearRoutesCommand}"
                                    Margin="0,6,0,0" Background="#5a3a3a" BorderBrush="#8a5a5a"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="자동설계된(라우팅된) 모든 경로를 삭제합니다. 동일 대상을 다시 라우팅하면 그 대상의 기존 설계는 자동으로 지워지고 진행됩니다."/>
                        </StackPanel>
                    </Border>

                    <!-- 3단계: 개별 PoC (작업) -->
                    <Border Grid.Row="2" Background="#2b3548" Padding="6"
                            BorderBrush="#404a64" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="③ 개별 PoC (선택 = 3D 강조)"
                                       FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding PocList}"
                                     SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Rectangle Width="14" Height="14" Fill="{Binding Swatch}"
                                                       Stroke="#888" StrokeThickness="0.5"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PocDisplay}" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== CENTER: 3D 뷰 + 하단 레이어 토글 ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <h:HelixViewport3D x:Name="View" Grid.Row="0"
                                   Background="#0f1320"
                                   ZoomExtentsWhenLoaded="True"
                                   ShowCoordinateSystem="True"
                                   ShowViewCube="True"
                                   IsHeadLightEnabled="True"
                                   ModelUpDirection="0,0,1">
                    <h:DefaultLights/>
                    <!-- 바닥 격자: 씬 좌표에 맞춰 코드비하인드가 Center/Width/Length 를 갱신(SceneRebuilt).
                         하드코딩하면 실제 DB 좌표(수만 mm)와 떨어져 ZoomExtents 가 빗나간다. -->
                    <h:GridLinesVisual3D x:Name="GroundGrid"
                                         Center="0,0,0" Width="1000" Length="1000"
                                         MinorDistance="1000" MajorDistance="1000" Thickness="2"
                                         Normal="0,0,1" LengthDirection="1,0,0"
                                         Fill="#404a64"/>
                    <ModelVisual3D Content="{Binding SceneModel}"/>
                    <ModelVisual3D Content="{Binding SearchModel}"/>      <!-- A* 단계별 탐색 오버레이 -->
                    <ModelVisual3D Content="{Binding SelectionModel}"/>   <!-- 선택 PoC 강조 마커 -->
                    <ModelVisual3D Content="{Binding StepHighlightModel}"/> <!-- 선택 경로 구간 강조(흰색) -->
                    <ModelVisual3D Content="{Binding CompareModel}"/>     <!-- 기존설계 비교(주황=기존/시안=개발) -->
                    <ModelVisual3D Content="{Binding LiveRouteModel}"/>   <!-- 진행 다이얼로그 라우팅 라이브(배관 완료마다 점진) -->
                    <ModelVisual3D Content="{Binding HighlightModel}"/>   <!-- 3D 클릭 선택 객체 강조 -->
                </h:HelixViewport3D>

                <!-- 레이어 표시: SpaceAI 와 같이 viewport 하단 가로형 WrapPanel -->
                <Border Grid.Row="1" Background="#252b3d" BorderBrush="#404a64"
                        BorderThickness="0,1,0,0" Padding="8,5">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="레이어 표시:"
                                   FontWeight="Bold" Foreground="#bfc6d6"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <WrapPanel Orientation="Horizontal" ItemHeight="22">
                            <!-- ───── 객체: BIM 객체 렌더링(경로탐색 무관) ───── -->
                            <TextBlock Text="객체" Foreground="#7f8aa3" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="장애물" Foreground="#AFAFAF"
                                      IsChecked="{Binding ShowObstacles}" Margin="0,0,12,0"
                                      ToolTip="장애물 (TB_BIM_OBSTACLES) AABB"/>
                            <CheckBox Content="장비" Foreground="#FF8C00"
                                      IsChecked="{Binding ShowEquipment}" Margin="0,0,12,0"
                                      ToolTip="TB_BIM_EQUIPMENT(SOURCE_FILE 조건)의 장비를 주황 큐브 박스로 표시(메인은 진하게)"/>
                            <CheckBox Content="레터럴" Foreground="#5AD282"
                                      IsChecked="{Binding ShowLaterals}" Margin="0,0,12,0"
                                      ToolTip="TB_DUCT_LATERAL 의 CATEGORY=LATERAL 을 초록 박스로 표시"/>
                            <CheckBox Content="덕트" Foreground="#6EAFDC"
                                      IsChecked="{Binding ShowDucts}" Margin="0,0,12,0"
                                      ToolTip="TB_DUCT_LATERAL 의 CATEGORY=DUCT 을 청색 박스로 표시"/>
                            <CheckBox Content="공간"
                                      IsChecked="{Binding ShowSpaces}" Margin="0,0,12,0"
                                      ToolTip="공간 영역 — TB_BIM_SPACE_INFO 의 구역(CR/A/F/CSF)을 선형 와이어프레임 + 텍스트 라벨로 표시"/>
                            <CheckBox Content="기존배관"
                                      IsChecked="{Binding ShowExistingPipes}" Margin="0,0,12,0"
                                      ToolTip="기존 설계배관 — TB_ROUTE_PATH(메인 장비 PoC→종단)을 유틸리티 색의 가는 튜브로 표시"/>
                            <CheckBox Content="배관자재"
                                      IsChecked="{Binding ShowFittings}" Margin="0,0,12,0"
                                      ToolTip="배관 자재(연결부) — TB_ROUTE_SEGMENT_DETAIL 의 실제 부속(엘보·티·밸브·플랜지·레듀서·유니온·클램프 등, 직관/PoC/현장벤딩 제외)을 부속 위치에 타입별 색 cube box 로 표시. 그룹 AABB 로 클리핑."/>

                            <Border Width="1" Background="#404a64" Margin="2,1,12,1"/>
                            <!-- ───── 경로: 라우팅 결과 렌더링 ───── -->
                            <TextBlock Text="경로" Foreground="#7f8aa3" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="자동경로"
                                      IsChecked="{Binding ShowPaths}" Margin="0,0,12,0"
                                      ToolTip="자동 라우팅 경로 (유틸리티별 색 튜브)"/>
                            <CheckBox Content="스텁" Foreground="#E23030"
                                      IsChecked="{Binding ShowStubs}" Margin="0,0,12,0"
                                      ToolTip="기존 설계배관의 출발(빨강)·종단(파랑) 스텁 = 수직배관 + 엘보(수직→수평 전환)를 굵은 색 튜브로 강조합니다. 유틸리티 그룹/유틸을 선택하면 그 그룹의 기존배관 스텁만 보입니다."/>
                            <CheckBox Content="PoC 마커" Foreground="#E65050"
                                      IsChecked="{Binding ShowPocMarkers}" Margin="0,0,12,0"
                                      ToolTip="모든 작업(장비)의 시작 PoC(빨강 구)·종단 PoC(파랑 구)를 라우팅 전에도 표시. 유틸 필터·선택 그룹을 동일 적용."/>
                            <CheckBox Content="충돌" Foreground="#E646E6"
                                      IsChecked="{Binding ShowCollisions}" Margin="0,0,12,0"
                                      ToolTip="충돌 셀 (≥2 배관이 공유하는 셀, 빨간 큐브)"/>
                            <CheckBox Content="{Binding BundleGroupStatus}"
                                      IsChecked="{Binding ShowBundleGroups}" Margin="0,0,12,0"
                                      ToolTip="그룹배관 강조 — 탐지된 번들(동일 이격간격·2회 이상 꺾임 평행 다발)을 그룹별 고유 색으로, 비멤버는 흐리게. DB 적재 필요: python -m routing3d_py.bundle_detect --project N --write-db. 미적재면 비활성."/>
                            <CheckBox Content="{Binding BundlePatternStatus}" Foreground="#BE78EB"
                                      IsChecked="{Binding ShowBundlePattern}" Margin="0,0,12,0"
                                      ToolTip="그룹배관 패턴 표시 — 기존설계에서 학습한 유틸별 '공용 트렁크 레인'(L4)을 보라색 반투명 큐브로 메인 3D 에 그립니다. 이 셀들이 곧 자동 라우팅에 주입되는 회랑이라, 새 경로가 어떤 레인을 따라 다발로 뭉칠지 미리 보입니다. 좌측에서 그룹/유틸을 선택하면 그 부분집합 패턴만. DB 적재 필요(bundle_detect --write-db). 미적재면 비활성."/>

                            <Border Width="1" Background="#404a64" Margin="2,1,12,1"/>
                            <!-- ───── 라우팅: 경로 결과를 바꾸는 옵션 ───── -->
                            <TextBlock Text="라우팅" Foreground="#7f8aa3" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="{Binding PatternStatus}"
                                      IsChecked="{Binding UsePatterns}" Margin="0,0,12,0"
                                      ToolTip="기존설계 패턴(L2a) — 학습한 진출/진입 면(장비=아래·덕트=상부 등)으로 시작/종단 PoC를 표면 투영해 자동라우팅을 사람 설계에 맞춥니다. 미적재/키 미스면 최근접-면 폴백. 기본 ON."/>
                            <CheckBox Content="스텁 라우팅"
                                      IsChecked="{Binding UseStubRouting}" Margin="0,0,12,0"
                                      ToolTip="스텁 라우팅 — 매칭 기존배관의 출발/종단 스텁(수직+엘보)을 고정 설계 구간으로 깔고, A*는 스텁 끝(랙 위)에서 시작/종료. 표시=출발 스텁+A* 중간+종단 스텁. 매칭 없으면 PoC 직접 라우팅 폴백. 기본 ON."/>
                            <Border Width="1" Background="#404a64" Margin="2,1,8,1"/>
                            <!-- 경로 방식 3-모드 선택(상호 배타) -->
                            <TextBlock Text="경로 방식:" Foreground="#7f8aa3" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <RadioButton Content="최단경로" GroupName="RouteMode" Margin="0,0,8,0"
                                         VerticalAlignment="Center" IsChecked="{Binding IsModeShortest}"
                                         ToolTip="최단경로 — 그룹/기존설계 패턴을 무시하고 순수 최단 A*로 라우팅합니다(스텁·면투영 토글은 별도)."/>
                            <RadioButton Content="그룹패턴 경유" GroupName="RouteMode" Margin="0,0,8,0"
                                         VerticalAlignment="Center" IsChecked="{Binding IsModeGroupPattern}"
                                         ToolTip="그룹패턴 경유 — 매칭되는 그룹배관(기존설계)의 꺾임점(수직↔수평·수평간 꺾임)을 '반드시 경유'하도록 코너 사이를 A*로 잇습니다. 코너 사이는 최단, 코너는 강제 통과 → 그룹배관 골격을 따라 다발로 모입니다. 매칭 없으면 최단 폴백. 기본값."/>
                            <RadioButton Content="기존설계 추종" GroupName="RouteMode" Margin="0,0,12,0"
                                         VerticalAlignment="Center" IsChecked="{Binding IsModeFollowExisting}"
                                         ToolTip="기존설계 추종 — 매칭 기존배관 폴리라인을 그대로 복제하고, 현재 점유에서 막힌(장애물이 달라진) 구간만 A*로 국소 우회합니다. 가장 강한 추종. 매칭 없으면 최단 폴백."/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== RIGHT: 세로 2단 — 위) 자동설계 결과 경로 리스트 / 아래) 분석결과 ===== -->
            <Border Grid.Column="2" Background="#252b3d" BorderBrush="#404a64"
                    BorderThickness="1,0,0,0">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="200"/>   <!-- 위: 결과 경로 리스트 -->
                        <RowDefinition Height="Auto"/>                 <!-- 스플리터 -->
                        <RowDefinition Height="2*" MinHeight="140"/>   <!-- 아래: 분석결과 -->
                    </Grid.RowDefinitions>

                    <!-- (위) 자동설계 결과 경로 리스트 -->
                    <Border Grid.Row="0" Background="#2b3548" BorderBrush="#404a64" BorderThickness="1">
                        <DockPanel LastChildFill="True" Margin="6">
                            <TextBlock DockPanel.Dock="Top" Text="자동설계 결과 경로" FontWeight="Bold" Margin="0,0,0,6"/>
                            <!-- 전체 진행상황: 진행바 + 텍스트(완료 N/M · 성공/실패 · %). 라우팅 중 라이브 갱신. -->
                            <Border DockPanel.Dock="Top" Background="#252b3d" BorderBrush="#404a64"
                                    BorderThickness="1" Padding="6,4" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding RouteProgressText}" Foreground="#cdd6f4"
                                               FontSize="11" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding RouteProgressValue, Mode=OneWay}" Minimum="0" Maximum="100"
                                                 Height="8" Background="#1e2230" Foreground="#5AD282"
                                                 BorderBrush="#404a64" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                            <DataGrid ItemsSource="{Binding ResultList}"
                                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      CanUserAddRows="False" SelectionMode="Single"
                                      Background="#252b3d" RowBackground="#252b3d"
                                      AlternatingRowBackground="#2b3548" Foreground="#e8eaf0"
                                      BorderBrush="#404a64" HorizontalGridLinesBrush="#333b50"
                                      FontFamily="Consolas" FontSize="11">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#2b3548"/>
                                        <Setter Property="Foreground" Value="#bfc6d6"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Setter Property="BorderBrush" Value="#404a64"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34"/>
                                    <DataGridTextColumn Header="유틸" Binding="{Binding Utility}" Width="64"/>
                                    <DataGridTextColumn Header="시작PoC" Binding="{Binding PocName}" Width="*"/>
                                    <DataGridTextColumn Header="종단PoC" Binding="{Binding EndName}" Width="*"/>
                                    <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="62">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="길이mm" Binding="{Binding LengthText}" Width="72">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="꺾임" Binding="{Binding TurnCount}" Width="48">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  Background="#404a64" ResizeBehavior="PreviousAndNext" Margin="0,4"/>

                    <!-- (아래) 분석결과 -->
                    <Border Grid.Row="2" Background="#2b3548" BorderBrush="#404a64" BorderThickness="1">
                        <DockPanel LastChildFill="True" Margin="6">
                            <TextBlock DockPanel.Dock="Top" Text="분석결과 (행 선택 = 해당 배관 / 미선택 = 집계)"
                                       FontWeight="Bold" Margin="0,0,0,6"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AnalysisReport, TargetNullValue='위 결과 리스트에서 배관을 클릭하면 그 경로 분석을, 미선택이면 전체 집계를 표시합니다.'}"
                                           Foreground="#cdd6f4" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12" LineHeight="17"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =========== Status bar =========== -->
        <Border Grid.Row="2" Background="#252b3d" BorderBrush="#404a64" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Foreground="#bfc6d6" Margin="8,4"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
