<Window x:Class="Routing3D.AutoRouteViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:Routing3D.AutoRouteViewer.ViewModels"
        Title="Routing3D Viewer — AutoRouteModule · PostgreSQL" Width="1900" Height="1000"
        Background="#0f1420">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#252e43" BorderBrush="#3a4865" BorderThickness="0,0,0,1" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DB:" Foreground="#dbeafe" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                <TextBox Grid.Column="2" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                <TextBox Grid.Column="3" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                <TextBox Grid.Column="4" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                <TextBox Grid.Column="5" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                <TextBlock Grid.Column="6" Text="프로젝트:" Foreground="#dbeafe" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox Grid.Column="7" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Display" Margin="2,0" />
                <Button Grid.Column="8" Content="↻ 목록" Command="{Binding LoadProjectsCommand}" Margin="4,0" />
                <Button Grid.Column="9" Content="↻ 로드" Command="{Binding LoadPostgresCommand}" Margin="4,0" />
                <Button Grid.Column="10" Content="◎ 기존설계" Command="{Binding LoadDemoCommand}" Margin="4,0" />
                <Button Grid.Column="11" Content="□ 전체보기" Click="FitView_Click" Margin="4,0" />
                <StackPanel Grid.Column="13" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Sweep" IsChecked="{Binding UseSweepGeometry}" Foreground="#facc15" VerticalAlignment="Center" Margin="6,0" />
                    <Button Content="취소" Command="{Binding CancelCommand}" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#20293b" Foreground="#dbeafe">
            <TextBlock Text="{Binding Status}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="315" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#243047" BorderBrush="#3d4a63" BorderThickness="0,0,1,0">
                <StackPanel Margin="8">
                    <TextBlock Text="① 유틸리티 그룹" Foreground="White" FontWeight="Bold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding UtilityGroups}" SelectedItem="{Binding SelectedUtilityGroup}" Margin="0,0,0,8" />
                    <Button Content="▶ 이 그룹 전체 라우팅" Command="{Binding RouteFilteredCommand}" Height="28" Background="#416996" Foreground="White" Margin="0,0,0,14" />

                    <TextBlock Text="② 유틸리티" Foreground="White" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Utilities}" SelectedItem="{Binding SelectedUtility}" Height="96" Margin="0,0,0,8" />
                    <Button Content="▶ 이 유틸리티 전체 라우팅" Command="{Binding RouteFilteredCommand}" Height="28" Margin="0,0,0,6" />
                    <Button Content="▣ 자동설계 경로 삭제" Height="28" Background="#6f3335" Foreground="White" Margin="0,0,0,14" />

                    <TextBlock Text="③ 개발 PoC / 기존 경로" Foreground="White" FontWeight="Bold" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" AutoGenerateColumns="False" IsReadOnly="True" Height="530" Background="#eef2ff">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RouteId}" Width="85" />
                            <DataGridTextColumn Header="그룹" Binding="{Binding UtilityGroup}" Width="75" />
                            <DataGridTextColumn Header="유틸" Binding="{Binding Utility}" Width="65" />
                            <DataGridTextColumn Header="시작PoC" Binding="{Binding SourceName}" Width="90" />
                            <DataGridTextColumn Header="종단PoC" Binding="{Binding TargetName}" Width="90" />
                            <DataGridTextColumn Header="세그" Binding="{Binding SegmentCount}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="선택 경로 라우팅" Command="{Binding RouteSelectedCommand}" Height="30" Margin="0,8,0,0" Background="#405f88" Foreground="White" />
                    <TextBlock Foreground="#dbeafe" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run Text="설비 "/><Run Text="{Binding EquipmentCount, Mode=OneWay}"/><Run Text=" · 덕트 "/><Run Text="{Binding DuctCount, Mode=OneWay}"/><Run Text=" · 레터럴 "/><Run Text="{Binding LateralCount, Mode=OneWay}"/>
                        <LineBreak />
                        <Run Text="기존배관 "/><Run Text="{Binding ExistingPipeCount, Mode=OneWay}"/><Run Text=" · PoC "/><Run Text="{Binding PocCount, Mode=OneWay}"/><Run Text=" · 부속 "/><Run Text="{Binding FittingCount, Mode=OneWay}"/><Run Text=" · 검색솔리드 "/><Run Text="{Binding RoutingSolidCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Background="#0b1020">
                <h:HelixViewport3D x:Name="MainViewport" ZoomExtentsWhenLoaded="True" ShowCoordinateSystem="True" ShowFrameRate="True" Background="#0b1020">
                    <h:DefaultLights />
                    <ModelVisual3D Content="{Binding SceneModel}" />
                </h:HelixViewport3D>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8" Background="#b51f2937">
                    <WrapPanel>
                        <TextBlock Text="레이어 표시:" Foreground="#dbeafe" Margin="0,0,10,0" />
                        <CheckBox Content="객체" IsChecked="{Binding ShowBoundsFrame, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="장애물" IsChecked="{Binding ShowObstacles, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="설비" IsChecked="{Binding ShowEquipment, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="덕트" IsChecked="{Binding ShowDucts, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="레터럴" IsChecked="{Binding ShowLaterals, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="공간" IsChecked="{Binding ShowSpaces, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="기존배관" IsChecked="{Binding ShowExistingPipes, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="자동경로" IsChecked="{Binding ShowAutoRoutes, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="PoC" IsChecked="{Binding ShowPocMarkers, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                        <CheckBox Content="부속" IsChecked="{Binding ShowFittings, Mode=TwoWay}" Foreground="White" Margin="0,0,8,0" />
                    </WrapPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Background="#20283b">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" MinHeight="180" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#2b3548" BorderBrush="#404a64" BorderThickness="1" Margin="8,8,8,0">
                    <DockPanel LastChildFill="True" Margin="6">
                        <TextBlock DockPanel.Dock="Top" Text="자동설계 결과 경로" Foreground="White" FontWeight="Bold" Margin="0,0,0,6" />
                        <Border DockPanel.Dock="Top" Background="#252b3d" BorderBrush="#404a64" BorderThickness="1" Padding="6,4" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Status}" Foreground="#cdd6f4" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                <ProgressBar Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0" Background="#1e2230" Foreground="#5AD282" BorderThickness="0" />
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding Comparisons}" SelectedItem="{Binding SelectedComparison}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="#252b3d" RowBackground="#252b3d" AlternatingRowBackground="#2b3548" Foreground="#e8eaf0"
                                  BorderBrush="#404a64" HorizontalGridLinesBrush="#333b50" FontFamily="Consolas" FontSize="11">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2b3548" />
                                    <Setter Property="Foreground" Value="#bfc6d6" />
                                    <Setter Property="Padding" Value="5,3" />
                                    <Setter Property="BorderBrush" Value="#404a64" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding RouteId}" Width="70" />
                                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#E65555" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                    <Setter Property="Foreground" Value="#5AD282" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="실패사유" Binding="{Binding FailReasonText}" Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ffb0b0" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="유틸" Binding="{Binding Utility}" Width="55" />
                                <DataGridTextColumn Header="시작PoC" Binding="{Binding SourceName}" Width="90" />
                                <DataGridTextColumn Header="종단PoC" Binding="{Binding TargetName}" Width="90" />
                                <DataGridTextColumn Header="길이mm" Binding="{Binding LengthText}" Width="70" />
                                <DataGridTextColumn Header="꺾임" Binding="{Binding TurnCount}" Width="50" />
                                <DataGridTextColumn Header="시간" Binding="{Binding ElapsedText}" Width="60" />
                                <DataGridTextColumn Header="확장" Binding="{Binding ExpandedText}" Width="80" />
                                <DataGridTextColumn Header="시작보정" Binding="{Binding StartOffsetMm, StringFormat=N0}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#404a64" Margin="8,4" />

                <Border Grid.Row="2" Background="#2b3548" BorderBrush="#404a64" BorderThickness="1" Margin="8,0,8,8">
                    <TabControl Margin="4" Background="#2b3548" BorderBrush="#404a64" BorderThickness="0">
                        <TabItem Header="분석결과">
                            <Border Background="#2b3548" Padding="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedComparison.Message, TargetNullValue='위 결과 리스트에서 배관을 클릭하면 그 경로 분석을 표시합니다.'}"
                                               Foreground="#cdd6f4" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" LineHeight="17" />
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                        <TabItem Header="단계별 경로">
                            <DockPanel LastChildFill="True" Background="#2b3548" Margin="0,4,0,0">
                                <DataGrid ItemsSource="{Binding SelectedComparison.StepRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Background="#252b3d" RowBackground="#252b3d" AlternatingRowBackground="#2b3548" Foreground="#e8eaf0"
                                          BorderBrush="#404a64" HorizontalGridLinesBrush="#333b50" FontFamily="Consolas" FontSize="11">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#2b3548" />
                                            <Setter Property="Foreground" Value="#bfc6d6" />
                                            <Setter Property="Padding" Value="5,3" />
                                            <Setter Property="BorderBrush" Value="#404a64" />
                                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="단계" Binding="{Binding Seq}" Width="44" />
                                        <DataGridTextColumn Header="구분" Binding="{Binding Kind}" Width="52" />
                                        <DataGridTextColumn Header="방향" Binding="{Binding Direction}" Width="100" />
                                        <DataGridTextColumn Header="길이" Binding="{Binding Length}" Width="80" />
                                        <DataGridTextColumn Header="영역" Binding="{Binding Region}" Width="110" />
                                        <DataGridTextColumn Header="꺾임 사유 / 좌표" Binding="{Binding Reason}" Width="240" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
